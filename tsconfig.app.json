{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [
    "src/main.tsx",
    "src/App.tsx",
    "src/components/ClientTicker.tsx",
    "src/components/ContactFooter.tsx",
    "src/components/CustomCursor.tsx",
    "src/components/FittedText.tsx",
    "src/components/HeroSection.tsx",
    "src/components/LiquidImage.tsx",
    "src/components/Navbar.tsx",
    "src/components/ServicesSection.tsx",
    "src/components/RingField.tsx",
    "src/components/SmokeBackground.tsx",
    "src/components/StudioSection.tsx",
    "src/components/WorkSection.tsx"
  ],
  "include": ["src/**/*"]
}
